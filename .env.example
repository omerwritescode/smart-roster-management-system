# Postgres connection. On Supabase click Connect, choose Transaction pooler (port 6543),
# and replace the password placeholder.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: Gemini explanations. Without a key the app uses template explanations.
# Create a free key in Google AI Studio. Do not link a billing account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: receives a JSON payload when a roster is published (for example an n8n webhook).
NOTIFY_WEBHOOK_URL=

# Recommended on Vercel: protects the daily keep-alive route. Vercel sends it automatically.
CRON_SECRET=

# Solver tuning. Defaults suit Vercel Hobby (1 vCPU).
SOLVER_TIME_LIMIT=18
SOLVER_COMPARE_TIME_LIMIT=12
SOLVER_WORKERS=4
